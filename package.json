{
  "name": "expression-practice-coach",
  "productName": "Phrio",
  "version": "0.1.0-alpha.0",
  "description": "A local-first Chinese speaking practice desktop app.",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "MIT",
  "author": "Song Dewen",
  "homepage": "https://github.com/Dewensong/phrio-speech-coach#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dewensong/phrio-speech-coach.git"
  },
  "bugs": {
    "url": "https://github.com/Dewensong/phrio-speech-coach/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ],
    "overrides": {
      "fast-uri": "3.1.4",
      "tar": "7.5.19",
      "tmp": "0.2.7"
    }
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "node scripts/prepare-dmg-maker.mjs && electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:asr": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local-asr-benchmark.mts",
    "smoke:packaged": "out/Phrio-darwin-arm64/Phrio.app/Contents/MacOS/Phrio --phrio-smoke-test",
    "smoke:packaged-asr": "out/Phrio-darwin-arm64/Phrio.app/Contents/MacOS/Phrio --phrio-asr-dependency-smoke-test",
    "verify:electron-system-network": "electron scripts/verify-electron-system-network.cjs",
    "verify:electron-power-save-blocker": "electron scripts/verify-electron-power-save-blocker.cjs",
    "verify:open-source": "node scripts/verify-open-source-readiness.mjs",
    "verify:packaged-macos": "node scripts/verify-packaged-macos.mjs",
    "verify:release-candidate": "node scripts/verify-release-candidate.mjs",
    "verify:electron-visual": "node scripts/verify-electron-visual.mjs",
    "verify:electron-product-tour": "node scripts/verify-electron-product-tour.mjs",
    "capture:propagation-assets": "node scripts/capture-propagation-assets.mjs",
    "build:brand-assets": "node scripts/build-brand-assets.mjs",
    "ci:evidence": "node scripts/create-ci-evidence.mjs",
    "verify": "pnpm verify:open-source && pnpm typecheck && pnpm test && pnpm verify:electron-system-network && pnpm verify:electron-power-save-blocker && pnpm package && pnpm verify:packaged-macos && pnpm smoke:packaged && pnpm smoke:packaged-asr"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sherpa-onnx-node": "1.13.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@electron/node-gyp": "10.2.0-electron.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "jsdom": "29.1.1",
    "playwright-core": "^1.61.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
