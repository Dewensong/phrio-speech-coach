{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phrio.local/schemas/asr-benchmark-manifest-v1.json",
  "title": "Phrio local ASR benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunkMs": { "type": "integer", "minimum": 20, "maximum": 1000, "default": 64 }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audio", "reference", "language"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "audio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^/\\\\].*\\.[wW][aA][vV]$"
        },
        "audioSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": { "type": "string", "minLength": 1, "maxLength": 50000 },
        "language": { "enum": ["zh", "en", "mixed"] },
        "speechSpans": {
          "type": "array",
          "maxItems": 1000,
          "description": "Canonical 16 kHz mono PCM spans. The executable loader additionally enforces end > start, ordering, non-overlap, and decoded-audio bounds.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startSample", "endSample"],
            "properties": {
              "startSample": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "endSample": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            }
          },
          "default": []
        },
        "keyTerms": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonical", "occurrences"],
            "properties": {
              "canonical": { "type": "string", "minLength": 1, "maxLength": 200 },
              "aliases": {
                "type": "array",
                "maxItems": 50,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 },
                "default": []
              },
              "occurrences": { "type": "integer", "minimum": 1, "maximum": 1000 }
            }
          },
          "default": []
        },
        "chunkMs": { "type": "integer", "minimum": 20, "maximum": 1000 },
        "skip": { "type": "boolean", "default": false },
        "skipReason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "skip": { "const": true } },
            "required": ["skip"]
          },
          "then": {
            "required": ["skipReason"],
            "properties": { "skipReason": true }
          },
          "else": {
            "required": ["speechSpans"],
            "properties": {
              "speechSpans": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "language": { "const": "mixed" } },
            "required": ["language"]
          },
          "then": {
            "required": ["keyTerms"],
            "properties": { "keyTerms": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    }
  }
}
